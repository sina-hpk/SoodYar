diff --git a/server/prisma/migrations/20260910000000_add_benchmarks/migration.sql b/server/prisma/migrations/20260910000000_add_benchmarks/migration.sql
new file mode 100644
index 0000000..12f3bb8
--- /dev/null
+++ b/server/prisma/migrations/20260910000000_add_benchmarks/migration.sql
@@ -0,0 +1,43 @@
+-- Safe additive migration: only creates independent benchmark tables/indexes.
+-- Do not apply automatically to an existing database; review and run on a copy first.
+CREATE TABLE "BenchmarkInstrument" (
+    "key" TEXT NOT NULL PRIMARY KEY,
+    "name" TEXT NOT NULL,
+    "unit" TEXT NOT NULL,
+    "marketKey" TEXT NOT NULL,
+    "isActive" BOOLEAN NOT NULL DEFAULT true,
+    "createdAt" DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updatedAt" DATETIME NOT NULL
+);
+
+CREATE TABLE "BenchmarkPrice" (
+    "id" TEXT NOT NULL PRIMARY KEY,
+    "instrumentKey" TEXT NOT NULL,
+    "priceRial" BIGINT NOT NULL,
+    "priceDate" DATETIME NOT NULL,
+    "source" TEXT NOT NULL,
+    "sourceRef" TEXT,
+    "ingestMethod" TEXT NOT NULL,
+    "ingestBatchId" TEXT,
+    "qualityStatus" TEXT NOT NULL DEFAULT 'ACCEPTED',
+    "marketDateConfirmed" BOOLEAN NOT NULL DEFAULT false,
+    "note" TEXT,
+    "createdAt" DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updatedAt" DATETIME NOT NULL,
+    CONSTRAINT "BenchmarkPrice_instrumentKey_fkey"
+        FOREIGN KEY ("instrumentKey") REFERENCES "BenchmarkInstrument" ("key")
+        ON DELETE RESTRICT ON UPDATE CASCADE
+);
+
+CREATE UNIQUE INDEX "BenchmarkInstrument_marketKey_key"
+    ON "BenchmarkInstrument"("marketKey");
+CREATE INDEX "BenchmarkInstrument_isActive_idx"
+    ON "BenchmarkInstrument"("isActive");
+CREATE UNIQUE INDEX "BenchmarkPrice_instrumentKey_priceDate_key"
+    ON "BenchmarkPrice"("instrumentKey", "priceDate");
+CREATE INDEX "BenchmarkPrice_priceDate_idx"
+    ON "BenchmarkPrice"("priceDate");
+CREATE INDEX "BenchmarkPrice_qualityStatus_idx"
+    ON "BenchmarkPrice"("qualityStatus");
+CREATE INDEX "BenchmarkPrice_instrumentKey_qualityStatus_priceDate_idx"
+    ON "BenchmarkPrice"("instrumentKey", "qualityStatus", "priceDate");
diff --git a/server/prisma/migrations/20260910120000_add_asset_market_key/migration.sql b/server/prisma/migrations/20260910120000_add_asset_market_key/migration.sql
new file mode 100644
index 0000000..572b6fc
--- /dev/null
+++ b/server/prisma/migrations/20260910120000_add_asset_market_key/migration.sql
@@ -0,0 +1,13 @@
+-- Additive migration for automatic market-price refresh.
+-- Adds two nullable columns to Asset so an asset can pin a live quote key and
+-- record when auto-refresh last wrote a price. Existing rows keep NULL, so no
+-- data is rewritten and the migration is safe to run on a populated database.
+--
+-- Operator command (run only after reviewing, and on a copy first):
+--   cd server
+--   npx prisma db execute --url "file:./prisma/dev.db" \
+--     --file prisma/migrations/20260910120000_add_asset_market_key/migration.sql
+-- (Do NOT use `prisma db push` / `prisma migrate` against the live DB.)
+
+ALTER TABLE "Asset" ADD COLUMN "marketKey" TEXT;
+ALTER TABLE "Asset" ADD COLUMN "lastAutoPriceAt" DATETIME;
diff --git a/server/prisma/schema.prisma b/server/prisma/schema.prisma
index 2886db2..f752c7a 100644
--- a/server/prisma/schema.prisma
+++ b/server/prisma/schema.prisma
@@ -52,6 +52,12 @@ model Asset {
   // position is fully closed, so Closed Positions keep their history.
   realizedPnl  String   @default("0")
   isActive     Boolean  @default(true)
+  // Explicit live-quote pin: which market.ts quote key feeds this asset during
+  // auto price refresh. Null means the matcher decides (symbol/name/alias).
+  marketKey       String?
+  // Last time the auto-refresh scheduler wrote a PriceSnapshot for this asset.
+  // Null means auto-refresh has never touched it (manual prices stay manual).
+  lastAutoPriceAt DateTime?
   createdAt    DateTime @default(now())
   updatedAt    DateTime @updatedAt
 
@@ -138,6 +144,48 @@ model PriceSnapshot {
   @@index([priceDate])
 }
 
+// Independent comparison instruments. Benchmarks are deliberately not Assets:
+// they never participate in portfolio holdings, NAV, WAC, or asset transactions.
+model BenchmarkInstrument {
+  key       String   @id // USD_IRR | GOLD18_IRR_GRAM | INFLATION_INDEX_IR
+  name      String
+  unit      String
+  // MARKET: a traded price the live market service can fetch.
+  // INDEX: a published index (e.g. consumer prices) fed only by manual/CSV rows.
+  kind      String   @default("MARKET")
+  marketKey String?  @unique // live market service key (usd | gram18); null for INDEX
+  isActive  Boolean  @default(true)
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+
+  prices BenchmarkPrice[]
+
+  @@index([isActive])
+}
+
+// Accepted/rejected dated observations for an independent benchmark.
+model BenchmarkPrice {
+  id                  String              @id @default(cuid())
+  instrumentKey       String
+  instrument          BenchmarkInstrument @relation(fields: [instrumentKey], references: [key])
+  priceRial           BigInt // positive integer rial
+  priceDate           DateTime // normalized market date, not ingestion timestamp
+  source              String // MANUAL | CSV | TGJU
+  sourceRef           String?
+  ingestMethod        String // MANUAL_JSON | CSV_JSON | LIVE_CAPTURE
+  ingestBatchId       String?
+  qualityStatus       String              @default("ACCEPTED") // ACCEPTED | REJECTED
+  marketDateConfirmed Boolean             @default(false)
+  note                String?
+  createdAt           DateTime            @default(now())
+  updatedAt           DateTime            @updatedAt
+
+  @@unique([instrumentKey, priceDate])
+  @@index([priceDate])
+  @@index([qualityStatus])
+  @@index([instrumentKey, qualityStatus, priceDate])
+}
+
 // Point-in-time NAV computation, reconstructable and dated.
 model NavSnapshot {
   id                String   @id @default(cuid())
