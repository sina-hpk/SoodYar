{
  "name": "soodyar",
  "version": "1.0.0",
  "private": true,
  "description": "SoodYar - Local-first group investment management (Unit/NAV model)",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "test": "npm run test --workspace server",
    "db:setup": "npm run db:setup --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
