# ---- SoodYar environment configuration (example) ----
# Copy this file to server/.env and adjust as needed.

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5300

# Database (SQLite for v1).
# For future PostgreSQL migration, switch provider in prisma/schema.prisma
# and set: DATABASE_URL="postgresql://user:pass@localhost:5432/soodyar?schema=public"
DATABASE_URL="file:./prisma/dev.db"

# Where SQLite backups are written (relative to server package root)
BACKUP_DIR=./backups

# Default NAV per unit (in RIAL, integer) used when no units exist yet.
DEFAULT_NAV_PER_UNIT=1000000
